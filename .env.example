# ============================================================
# Bitcoin Investment — environment configuration
# Copy to .env, fill in real values. NEVER commit .env.
# ============================================================

# --- Mode ---
# When true, the entire platform runs in SANDBOX MODE:
# no real payments, no real BTC purchases, no real withdrawals.
# All financial actions are simulated and clearly labeled.
# Do not set this to false until every provider below is a real,
# verified, production-approved integration (see README "Go-Live Checklist").
NEXT_PUBLIC_SANDBOX_MODE=true

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/bitcoin_investment?schema=public"

# --- Auth ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Redis (sessions, rate limiting, job queues) ---
REDIS_URL="redis://localhost:6379"

# --- Market data provider (e.g. CoinGecko, Kaiko, CoinMarketCap) ---
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER=coingecko

# --- KYC/AML provider (e.g. Sumsub, Persona, Onfido) ---
KYC_PROVIDER=
KYC_PROVIDER_KEY=
KYC_PROVIDER_WEBHOOK_SECRET=

# --- Payment provider (e.g. Stripe, a licensed on/off-ramp) ---
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# --- Custody provider (e.g. a qualified/regulated custodian, MPC wallet provider) ---
CUSTODY_PROVIDER=
CUSTODY_PROVIDER_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_URL=

# --- Email provider (e.g. Postmark, SES) ---
EMAIL_PROVIDER=
EMAIL_PROVIDER_KEY=

# --- SMS provider (e.g. Twilio) — future integration ---
SMS_PROVIDER=
SMS_PROVIDER_KEY=

# --- Compliance ---
SANCTIONS_SCREENING_PROVIDER=
SANCTIONS_SCREENING_KEY=

# --- Optional: create the first admin account when running `npx prisma db seed` ---
# Leave both blank and no admin account is created (nothing is fabricated
# by default). Set both to create one real admin login for local dev.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ROLE=super_admin
